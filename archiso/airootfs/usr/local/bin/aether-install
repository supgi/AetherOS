#!/usr/bin/env bash
# ==============================================================================
# Aether OS - Launcher Universal do Instalador na Mídia Live
# ==============================================================================

set -euo pipefail

AETHER_DIR="/opt/aether-os"

if [[ ! -d "${AETHER_DIR}" ]]; then
    echo -e "\033[1;31m[ERRO] Diretório de instalação ${AETHER_DIR} não encontrado.\033[0m" >&2
    exit 1
fi

if [[ $EUID -ne 0 ]]; then
    echo -e "\033[1;33m[AVISO] O instalador precisa ser executado como root. Solicitando sudo...\033[0m"
    exec sudo bash "${AETHER_DIR}/install.sh" "$@"
else
    exec bash "${AETHER_DIR}/install.sh" "$@"
fi
